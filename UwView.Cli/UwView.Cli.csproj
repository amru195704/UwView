<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>UwView.Cli</RootNamespace>
    <!-- コマンド名は uvf（無料版 UwView の CLI。オーナー指示 2026-09-14） -->
    <AssemblyName>uvf</AssemblyName>
    <Version>1.7.1.5</Version>

    <!-- 中身は「UwView 本体を CLI モードで起動する」だけの起動アプリ。
         .NET 一式を抱えると 36MB になるので、使わない部分を削って小さくする（オーナー指摘 2026-09-14） -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <EventSourceSupport>false</EventSourceSupport>
    <DebuggerSupport>false</DebuggerSupport>
    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!-- mac だけ: CLI の中身をこの実行ファイルの中で動かす NativeAOT 版にする（Program.cs の IN_PROCESS_CLI）。
       本体を起動し直さないので、起動が 0.14 秒 → 0.01 秒（rg と同じ）。NativeAOT はその OS の上でしか
       ビルドできないので、Linux・Windows は従来の起動アプリのまま（オーナー決定 2026-09-24）。
       RID を付けない dotnet build（開発・テスト）は従来の起動アプリになる。 -->
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('osx-'))">
    <PublishAot>true</PublishAot>
    <PublishSingleFile>false</PublishSingleFile>
    <DefineConstants>$(DefineConstants);IN_PROCESS_CLI</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- 中身を動かすので .NET の説明文を残す（削ると「正規表現が正しくありません: MakeException, [, 1, …」になる） -->
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
  </PropertyGroup>
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('osx-'))">
    <ProjectReference Include="../UwView.Core/UwView.Core.csproj" />
  </ItemGroup>

</Project>
