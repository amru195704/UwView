<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>UwView.Cli</RootNamespace>
    <!-- コマンド名は uvf（無料版 UwView の CLI。オーナー指示 2026-09-14） -->
    <AssemblyName>uvf</AssemblyName>
    <!-- GUI（UwView）と同じ版 -->
    <Version>1.6.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- 画面を持たないので Avalonia に依存しない。検索は GUI と同じ UwView.Core -->
    <ProjectReference Include="..\UwView.Core\UwView.Core.csproj" />
  </ItemGroup>

</Project>
