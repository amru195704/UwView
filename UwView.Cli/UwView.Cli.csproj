<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>UwView.Cli</RootNamespace>
    <!-- コマンド名は uvf（無料版 UwView の CLI。9.14修正） -->
    <AssemblyName>uvf</AssemblyName>
    <Version>1.8.0.1</Version>
    <InformationalVersion>1.8.0.1</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- ビルド番号＝コンパイル日時（ローカル時刻）を yy.MM.dd.HH に。版数の表示（version）に出す（本体の About と同じ値。10.4修正）。
         指定したいときは環境変数 UV_BUILD_NUMBER=26.10.04.16 のように渡す -->
    <BuildNumber>$([System.DateTime]::Now.ToString("yy.MM.dd.HH"))</BuildNumber>
    <BuildNumber Condition="'$(UV_BUILD_NUMBER)' != ''">$(UV_BUILD_NUMBER)</BuildNumber>

    <!-- 中身は「UwView 本体を CLI モードで起動する」だけの起動アプリ。
         .NET 一式を抱えると 36MB になるので、使わない部分を削って小さくする（9.14修正） -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <EventSourceSupport>false</EventSourceSupport>
    <DebuggerSupport>false</DebuggerSupport>
    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!-- mac と Linux: CLI の中身をこの実行ファイルの中で動かす NativeAOT 版にする（Program.cs の IN_PROCESS_CLI）。
       本体を起動し直さないので、起動が mac 0.14 秒・Linux 約 0.3 秒 → 0.01 秒前後（rg と同じ）。
       NativeAOT はその OS の上でしかビルドできないので、Linux は Mac の中の Linux（Colima＋Docker）で作る
       （build/publish.sh → UwView/build/linux-aot-cli.sh。2026-09-25）。Windows は従来の起動アプリのまま。
       RID を付けない dotnet build（開発・テスト）は従来の起動アプリになる。 -->
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('osx-')) Or $(RuntimeIdentifier.StartsWith('linux-'))">
    <PublishAot>true</PublishAot>
    <PublishSingleFile>false</PublishSingleFile>
    <DefineConstants>$(DefineConstants);IN_PROCESS_CLI</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- 中身を動かすので .NET の説明文を残す（削ると「正規表現が正しくありません: MakeException, [, 1, …」になる） -->
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
  </PropertyGroup>
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('osx-')) Or $(RuntimeIdentifier.StartsWith('linux-'))">
    <ProjectReference Include="../UwView.Core/UwView.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="BuildNumber" Value="$(BuildNumber)" />
  </ItemGroup>

</Project>
