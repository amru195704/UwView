<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:UwView.ViewModels"
             xmlns:ctrl="using:UwView.Controls"
             xmlns:loc="using:UwView.Localization"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="560"
             x:Class="UwView.Views.MainView"
             x:DataType="vm:MainViewModel"
             DragDrop.AllowDrop="True">
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <!-- アイコンボタン共通（余白なし・枠なし・アイコン実寸）。
             Material Icons(Apache-2.0) を Assets/Toolbar に同梱。ラベルはツールチップ。 -->
        <Style Selector="Button.icon, ToggleButton.icon">
            <Setter Property="Padding" Value="3" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <!-- アイコンだけでは機能が判らないので、素早く・無効時にも説明を出す -->
            <Setter Property="ToolTip.ShowDelay" Value="250" />
            <Setter Property="ToolTip.ShowOnDisabled" Value="True" />
        </Style>
        <Style Selector="Button.icon">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.icon > Image, ToggleButton.icon > Image">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
        </Style>

        <!-- 入力欄＋操作ボタンを1つの部品として囲む（[入力][操作] が1組と判るように） -->
        <Style Selector="Border.inputGroup">
            <Setter Property="BorderBrush" Value="#9E9E9E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Padding" Value="2,1" />
        </Style>
        <!-- 内側の入力欄は二重枠にならないよう枠と背景を消す -->
        <Style Selector="Border.inputGroup TextBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.inputGroup AutoCompleteBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </UserControl.Styles>

    <DockPanel LastChildFill="True">

        <!-- タブストリップ（§4.7） -->
        <Border DockPanel.Dock="Top" Background="#E4E4E4" BorderBrush="#CCCCCC"
                BorderThickness="0,0,0,1" IsVisible="{Binding HasTabs}">
            <TabStrip ItemsSource="{Binding Tabs}"
                      SelectedItem="{Binding ActiveTab, Mode=TwoWay}">
                <TabStrip.ItemTemplate>
                    <DataTemplate x:DataType="vm:DocumentTabViewModel">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}" Foreground="Black" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding IndexProgress, StringFormat='{}{0:P0}'}"
                                       Foreground="Black" VerticalAlignment="Center"
                                       IsVisible="{Binding IsIndexing}" />
                            <Button Content="×" Padding="4,0" MinWidth="0" Background="Transparent"
                                    Foreground="Black"
                                    Command="{Binding CloseCommand}" />
                        </StackPanel>
                    </DataTemplate>
                </TabStrip.ItemTemplate>
            </TabStrip>
        </Border>

        <!-- ツールバー -->
        <Border DockPanel.Dock="Top" Background="#EEEEEE" BorderBrush="#CCCCCC"
                BorderThickness="0,0,0,1" Padding="6">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <!-- アイコンはすべてフラット統一（Material Icons）。ラベルはツールチップ -->
                <Button x:Name="OpenButton" Classes="icon" ToolTip.Tip="{loc:Localize Open}">
                    <Image RenderOptions.BitmapInterpolationMode="HighQuality" Source="avares://UwView/Assets/Toolbar/open.png" />
                </Button>
                <Button x:Name="CloseButton" Classes="icon" ToolTip.Tip="{loc:Localize CloseTabMenu}"
                        IsEnabled="{Binding HasTabs}">
                    <Image RenderOptions.BitmapInterpolationMode="HighQuality" Source="avares://UwView/Assets/Toolbar/close.png" />
                </Button>
                <ComboBox x:Name="EncodingCombo" MinWidth="130"
                          ToolTip.Tip="{loc:Localize EncodingLabel}"
                          ItemsSource="{Binding EncodingOptions}"
                          SelectedItem="{Binding SelectedEncoding, Mode=TwoWay}" />
                <CheckBox x:Name="LineNumberCheck" Content="{loc:Localize LineNumbers}" IsChecked="True" Foreground="Black" />
                <Rectangle Width="1" Fill="#CCCCCC" Margin="4,0" />
                <Border Classes="inputGroup">
                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <TextBox x:Name="JumpBox" Width="110" PlaceholderText="{loc:Localize JumpPlaceholder}"
                                 VerticalAlignment="Center" Text="{Binding JumpText, Mode=TwoWay}" />
                        <Button x:Name="JumpButton" Classes="icon" ToolTip.Tip="{loc:Localize JumpLabel}">
                            <Image RenderOptions.BitmapInterpolationMode="HighQuality" Source="avares://UwView/Assets/Toolbar/go.png" />
                        </Button>
                    </StackPanel>
                </Border>
                <Rectangle Width="1" Fill="#CCCCCC" Margin="4,0" />
                <Button x:Name="BookmarkToggleButton" Classes="icon" ToolTip.Tip="{loc:Localize BookmarkToggleTip}">
                    <Image RenderOptions.BitmapInterpolationMode="HighQuality" Source="avares://UwView/Assets/Toolbar/bookmark.png" />
                </Button>
                <Button x:Name="PrevBookmarkButton" Classes="icon" ToolTip.Tip="{loc:Localize PrevBookmarkTip}">
                    <Image RenderOptions.BitmapInterpolationMode="HighQuality" Source="avares://UwView/Assets/Toolbar/prev.png" />
                </Button>
                <Button x:Name="NextBookmarkButton" Classes="icon" ToolTip.Tip="{loc:Localize NextBookmarkTip}">
                    <Image RenderOptions.BitmapInterpolationMode="HighQuality" Source="avares://UwView/Assets/Toolbar/next.png" />
                </Button>
                <Rectangle Width="1" Fill="#CCCCCC" Margin="4,0" />
                <ToggleButton x:Name="TailToggle" Classes="icon" ToolTip.Tip="{loc:Localize TailTip}">
                    <Image RenderOptions.BitmapInterpolationMode="HighQuality" Source="avares://UwView/Assets/Toolbar/tail.png" />
                </ToggleButton>
                <ToggleButton x:Name="FavoriteToggle" Content="{loc:Localize Favorite}"
                              ToolTip.Tip="{loc:Localize FavoriteTip}" />
                <Rectangle Width="1" Fill="#CCCCCC" Margin="4,0" />
                <Button x:Name="HighlighterButton" Classes="icon" ToolTip.Tip="{loc:Localize HighlighterTip}">
                    <Image RenderOptions.BitmapInterpolationMode="HighQuality" Source="avares://UwView/Assets/Toolbar/highlighter.png" />
                </Button>
                <Rectangle Width="1" Fill="#CCCCCC" Margin="4,0" />
                <ComboBox x:Name="LanguageCombo" MinWidth="90"
                          ToolTip.Tip="{loc:Localize LanguageLabel}"
                          ItemsSource="{Binding Languages}"
                          SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" />
            </StackPanel>
        </Border>

        <!-- 検索バー（§11-①②⑥） -->
        <Border DockPanel.Dock="Top" Background="#F5F5F5" BorderBrush="#CCCCCC"
                BorderThickness="0,0,0,1" Padding="6,4">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border Classes="inputGroup">
                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <AutoCompleteBox x:Name="SearchBox" Width="220" Watermark="{loc:Localize SearchPlaceholder}"
                                         FilterMode="Contains" MinimumPrefixLength="0"
                                         VerticalAlignment="Center"
                                         ItemsSource="{Binding SearchHistory}"
                                         Text="{Binding SearchText, Mode=TwoWay}" />
                        <Button x:Name="SearchButton" Classes="icon" ToolTip.Tip="{loc:Localize SearchButton}">
                            <Image RenderOptions.BitmapInterpolationMode="HighQuality" Source="avares://UwView/Assets/Toolbar/search.png" />
                        </Button>
                        <Button x:Name="ClearSearchButton" Classes="icon" ToolTip.Tip="{loc:Localize ClearSearchTip}">
                            <Image RenderOptions.BitmapInterpolationMode="HighQuality" Source="avares://UwView/Assets/Toolbar/clear.png" />
                        </Button>
                    </StackPanel>
                </Border>
                <ComboBox x:Name="PredefinedCombo" MinWidth="120"
                          PlaceholderText="{loc:Localize PredefinedFilters}"
                          ItemsSource="{Binding PredefinedFilters}"
                          SelectedItem="{Binding SelectedPredefinedFilter, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" Foreground="Black" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button x:Name="SaveFilterButton" Content="★" ToolTip.Tip="{loc:Localize SavePredefinedTip}" />
                <CheckBox x:Name="RegexCheck" Content="{loc:Localize Regex}" Foreground="Black"
                          IsChecked="{Binding SearchIsRegex, Mode=TwoWay}" />
                <CheckBox x:Name="CaseCheck" Content="{loc:Localize IgnoreCase}" Foreground="Black"
                          IsChecked="{Binding SearchIgnoreCase, Mode=TwoWay}" />
                <Button x:Name="PrevHitButton" Classes="icon" ToolTip.Tip="{loc:Localize PrevHit}">
                    <Image RenderOptions.BitmapInterpolationMode="HighQuality" Source="avares://UwView/Assets/Toolbar/prev.png" />
                </Button>
                <Button x:Name="NextHitButton" Classes="icon" ToolTip.Tip="{loc:Localize NextHit}">
                    <Image RenderOptions.BitmapInterpolationMode="HighQuality" Source="avares://UwView/Assets/Toolbar/next.png" />
                </Button>
                <Button x:Name="FilterResultsButton" Classes="icon"
                        ToolTip.Tip="{loc:Localize FilterResultsOpenTip}">
                    <Image RenderOptions.BitmapInterpolationMode="HighQuality" Source="avares://UwView/Assets/Toolbar/results.png" />
                </Button>
                <TextBlock Text="{Binding SearchInfo}" VerticalAlignment="Center" Foreground="Black" />
            </StackPanel>
        </Border>

        <!-- ステータスバー -->
        <Border DockPanel.Dock="Bottom" Background="#EEEEEE" BorderBrush="#CCCCCC"
                BorderThickness="0,1,0,0" Padding="6,3">
            <DockPanel LastChildFill="True">
                <!-- 索引パネルを右に先に確保（左情報が食い込まない） -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8"
                            Margin="12,0,0,0" VerticalAlignment="Center"
                            IsVisible="{Binding IsIndexing}">
                    <TextBlock Text="{loc:Localize Indexing}" VerticalAlignment="Center" Foreground="Black" />
                    <ProgressBar Width="140" Minimum="0" Maximum="1"
                                 Value="{Binding IndexProgress}" />
                    <Button x:Name="CancelButton" Content="{loc:Localize Cancel}" />
                </StackPanel>
                <!-- 左情報は残り幅にクリップ（あふれても右へ重ならない） -->
                <StackPanel Orientation="Horizontal" Spacing="14" ClipToBounds="True"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding FilePath}" Foreground="Black" />
                    <TextBlock Text="{Binding ModeInfo}" Foreground="Black" />
                    <TextBlock Text="{Binding PositionInfo}" Foreground="Black" />
                    <TextBlock Text="{Binding EncodingInfo}" Foreground="Black" />
                    <TextBlock Text="{Binding Notice}" Foreground="#1A6FE8" FontWeight="SemiBold" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 本文 + ミニマップ + 縦スクロールバー（＋ 未オープン時のスタート画面） -->
        <Panel>
            <Grid ColumnDefinitions="*,Auto,Auto">
                <ctrl:TextView x:Name="TextView" Grid.Column="0" />
                <ctrl:MinimapView x:Name="Minimap" Grid.Column="1" />
                <ScrollBar x:Name="VScroll" Grid.Column="2" Orientation="Vertical"
                           AllowAutoHide="False" Width="16" />
            </Grid>

            <!-- スタート画面（ファイル未オープン時。最近使ったファイル・お気に入り） -->
            <Border Background="#FAFAFA" IsVisible="{Binding IsEmpty}">
                <Grid RowDefinitions="Auto,*" MaxWidth="720" Margin="24" VerticalAlignment="Center">
                    <StackPanel Grid.Row="0" Spacing="12" Margin="0,0,0,24">
                        <TextBlock Text="UwView" FontSize="30" FontWeight="Bold" Foreground="Black" />
                        <Button x:Name="StartOpenButton" Content="{loc:Localize StartOpen}"
                                HorizontalAlignment="Left" Padding="16,8" />
                    </StackPanel>
                    <Grid Grid.Row="1" ColumnDefinitions="*,24,*">
                        <DockPanel Grid.Column="0" LastChildFill="True">
                            <TextBlock DockPanel.Dock="Top" Text="{loc:Localize StartRecentTitle}"
                                       FontWeight="Bold" Foreground="Black" Margin="0,0,0,6" />
                            <TextBlock DockPanel.Dock="Top" Text="{loc:Localize StartHint}"
                                       Foreground="#777777" FontSize="12" Margin="0,0,0,6" />
                            <ListBox x:Name="StartRecentList" ItemsSource="{Binding StartRecent}"
                                     Background="White" MinHeight="200">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Spacing="0" Margin="2">
                                            <TextBlock Text="{Binding DisplayName}" Foreground="Black" />
                                            <TextBlock Text="{Binding Path}" Foreground="#888888" FontSize="11"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                        <DockPanel Grid.Column="2" LastChildFill="True">
                            <TextBlock DockPanel.Dock="Top" Text="{loc:Localize StartFavoritesTitle}"
                                       FontWeight="Bold" Foreground="Black" Margin="0,0,0,6" />
                            <TextBlock DockPanel.Dock="Top" Text="{loc:Localize StartHint}"
                                       Foreground="#777777" FontSize="12" Margin="0,0,0,6" />
                            <ListBox x:Name="StartFavoritesList" ItemsSource="{Binding StartFavorites}"
                                     Background="White" MinHeight="200">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Spacing="0" Margin="2">
                                            <TextBlock Text="{Binding DisplayName}" Foreground="Black" />
                                            <TextBlock Text="{Binding Path}" Foreground="#888888" FontSize="11"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Grid>
                </Grid>
            </Border>
        </Panel>

    </DockPanel>
</UserControl>
