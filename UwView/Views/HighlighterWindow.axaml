<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="using:UwView.Localization"
        mc:Ignorable="d" d:DesignWidth="880" d:DesignHeight="520"
        x:Class="UwView.Views.HighlighterWindow"
        Title="{loc:Localize HighlighterTitle}"
        Width="1000" Height="560" MinWidth="820" MinHeight="320">
    <!-- 中身は HighlighterView を code-behind でホストする（デスクトップ用ホスト）。 -->
</Window>
