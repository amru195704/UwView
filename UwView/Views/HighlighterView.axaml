<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:UwView.ViewModels"
             xmlns:loc="using:UwView.Localization"
             xmlns:conv="using:UwView.Converters"
             mc:Ignorable="d" d:DesignWidth="880" d:DesignHeight="520"
             x:Class="UwView.Views.HighlighterView"
             x:DataType="vm:HighlighterViewModel">

    <UserControl.Resources>
        <conv:HexToBrushConverter x:Key="HexToBrush" />
    </UserControl.Resources>

    <DockPanel LastChildFill="True">

        <!-- ツールバー -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Uv_EEEEEE}" BorderBrush="{DynamicResource Uv_CCCCCC}"
                BorderThickness="0,0,0,1" Padding="6">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="AddButton" 
                        ToolTip.Tip="{loc:Localize HlAddRule}"
                        AutomationProperties.Name="{loc:Localize HlAddRule}">
                    <Image Width="22" Height="22" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{DynamicResource Icon_add}" />
                </Button>
                <Rectangle Width="1" Fill="{DynamicResource Uv_CCCCCC}" Margin="2,0" />
                <TextBlock Text="{loc:Localize HlPreset}" VerticalAlignment="Center" Foreground="{DynamicResource Uv_Text}" />
                <ComboBox x:Name="PresetCombo" MinWidth="180"
                          PlaceholderText="{loc:Localize HlPresetPlaceholder}"
                          ItemsSource="{Binding Presets}"
                          SelectedItem="{Binding SelectedPreset, Mode=TwoWay}" />
                <Button x:Name="ReloadButton"
                        ToolTip.Tip="{loc:Localize HlReloadTip}"
                        AutomationProperties.Name="{loc:Localize HlReload}">
                    <Image Width="22" Height="22" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{DynamicResource Icon_refresh}" />
                </Button>
                <Rectangle Width="1" Fill="{DynamicResource Uv_CCCCCC}" Margin="2,0" />
                <Button x:Name="ExportButton" 
                        ToolTip.Tip="{loc:Localize HlExport}"
                        AutomationProperties.Name="{loc:Localize HlExport}">
                    <Image Width="22" Height="22" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{DynamicResource Icon_export}" />
                </Button>
                <Button x:Name="ImportButton" 
                        ToolTip.Tip="{loc:Localize HlImport}"
                        AutomationProperties.Name="{loc:Localize HlImport}">
                    <Image Width="22" Height="22" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{DynamicResource Icon_import}" />
                </Button>
            </StackPanel>
        </Border>

        <!-- 保存 / 閉じる -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Uv_EEEEEE}" BorderBrush="{DynamicResource Uv_CCCCCC}"
                BorderThickness="0,1,0,0" Padding="6">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button x:Name="SaveButton" Content="{loc:Localize Save}"
                        ToolTip.Tip="{loc:Localize HlSaveTip}" />
                <Button x:Name="ApplyButton"
                        ToolTip.Tip="{loc:Localize HlApplyTip}"
                        AutomationProperties.Name="{loc:Localize HlApply}">
                    <Image Width="22" Height="22" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{DynamicResource Icon_apply}" />
                </Button>
                <Button x:Name="CancelButton" Content="{loc:Localize Close}"
                        ToolTip.Tip="{loc:Localize HlCancelTip}" />
            </StackPanel>
        </Border>

        <!-- 注意書き（同時多用は見分けにくい・§2） -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Uv_FFF6D6}" BorderBrush="{DynamicResource Uv_E8CE7A}"
                BorderThickness="0,1,0,0" Padding="8,5">
            <TextBlock Text="{loc:Localize HlManyColorsNote}" Foreground="{DynamicResource Uv_Text}" TextWrapping="Wrap" />
        </Border>

        <!-- 列見出し -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Uv_F6F6F6}" BorderBrush="{DynamicResource Uv_DDDDDD}"
                BorderThickness="0,0,0,1" Padding="6,3">
            <!-- 末尾 20px は縦スクロールバー避けのスペーサー（右端の▲▼が隠れないように） -->
            <Grid ColumnDefinitions="48,26,30,56,*,46,40,52,90,56,90,56,20">
                <TextBlock Grid.Column="0" Text="↕" Foreground="{DynamicResource Uv_Text}" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="✓" Foreground="{DynamicResource Uv_Text}" />
                <TextBlock Grid.Column="2" Text="" />
                <TextBlock Grid.Column="3" Text="{loc:Localize HlColor}" Foreground="{DynamicResource Uv_Text}" />
                <TextBlock Grid.Column="4" Text="{loc:Localize HlPattern}" Foreground="{DynamicResource Uv_Text}" />
                <TextBlock Grid.Column="5" Text="{loc:Localize HlRegex}" Foreground="{DynamicResource Uv_Text}" />
                <TextBlock Grid.Column="6" Text="Aa" Foreground="{DynamicResource Uv_Text}" />
                <TextBlock Grid.Column="7" Text="{loc:Localize HlWholeLine}" Foreground="{DynamicResource Uv_Text}" />
                <TextBlock Grid.Column="8" Text="{loc:Localize HlForeground}" Foreground="{DynamicResource Uv_Text}" />
                <TextBlock Grid.Column="9" Text="" />
                <TextBlock Grid.Column="10" Text="{loc:Localize HlBackground}" Foreground="{DynamicResource Uv_Text}" />
                <TextBlock Grid.Column="11" Text="" />
            </Grid>
        </Border>

        <!-- 規則リスト（先頭が最優先＝下→上で後勝ち） -->
        <ListBox x:Name="RuleList" ItemsSource="{Binding Rules}" Background="{DynamicResource Uv_Surface}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="4,2" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:HlRuleRow">
                    <Grid ColumnDefinitions="48,26,30,56,*,46,40,52,90,56,90,56,20" VerticalAlignment="Center">
                        <!-- 行の並べ替え（先頭。▲＝上へ / ▼＝下へ） -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" Margin="0,0,8,0">
                            <Button Content="▲" Padding="4,0" MinWidth="0" Tag="{Binding}" Classes="moveUp"
                                    ToolTip.Tip="{loc:Localize HlMoveUpTip}" />
                            <Button Content="▼" Padding="4,0" MinWidth="0" Tag="{Binding}" Classes="moveDown"
                                    ToolTip.Tip="{loc:Localize HlMoveDownTip}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding Enabled, Mode=TwoWay}" Margin="4,0,0,0" />
                        <!-- 削除（チェックの後） -->
                        <Button Grid.Column="2" Content="✕" Padding="6,0" MinWidth="0"
                                Tag="{Binding}" Classes="delRule" />
                        <!-- 色プレビュー（背景=背景色 / 文字「AaBb」=文字色。文字色未指定は黒） -->
                        <Border Grid.Column="3" Height="20" CornerRadius="2" Margin="0,0,6,0"
                                BorderBrush="{DynamicResource Uv_BBBBBB}" BorderThickness="1"
                                Background="{Binding Background, Converter={StaticResource HexToBrush}}">
                            <TextBlock Text="AaBb" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, Converter={StaticResource HexToBrush}, ConverterParameter=fg}" />
                        </Border>
                        <!-- パターン（白背景） -->
                        <TextBox Grid.Column="4" Text="{Binding Pattern, Mode=TwoWay}" Margin="0,0,6,0" />
                        <CheckBox Grid.Column="5" IsChecked="{Binding IsRegex, Mode=TwoWay}" HorizontalAlignment="Center" />
                        <CheckBox Grid.Column="6" IsChecked="{Binding IgnoreCase, Mode=TwoWay}" HorizontalAlignment="Center" />
                        <CheckBox Grid.Column="7" IsChecked="{Binding WholeLine, Mode=TwoWay}" HorizontalAlignment="Center" />
                        <!-- 文字色コード -->
                        <TextBox Grid.Column="8" Text="{Binding Foreground, Mode=TwoWay}"
                                 Classes="fgColor" Watermark="#000000" Margin="0,0,4,0" />
                        <!-- 文字色 明るく/暗く（▲＝明るく / ▼＝暗く。各値 ±#10） -->
                        <StackPanel Grid.Column="9" Orientation="Horizontal" Spacing="2" Margin="0,0,2,0">
                            <Button Content="▲" Padding="4,0" MinWidth="0" Tag="{Binding}" Classes="fgUp"
                                    ToolTip.Tip="{loc:Localize HlBrighterTip}" />
                            <Button Content="▼" Padding="4,0" MinWidth="0" Tag="{Binding}" Classes="fgDown"
                                    ToolTip.Tip="{loc:Localize HlDarkenTip}" />
                        </StackPanel>
                        <!-- 背景色コード -->
                        <TextBox Grid.Column="10" Text="{Binding Background, Mode=TwoWay}"
                                 Classes="bgColor" Watermark="#RRGGBB" Margin="0,0,4,0" />
                        <!-- 背景色 明るく/暗く -->
                        <StackPanel Grid.Column="11" Orientation="Horizontal" Spacing="2">
                            <Button Content="▲" Padding="4,0" MinWidth="0" Tag="{Binding}" Classes="bgUp"
                                    ToolTip.Tip="{loc:Localize HlBrighterTip}" />
                            <Button Content="▼" Padding="4,0" MinWidth="0" Tag="{Binding}" Classes="bgDown"
                                    ToolTip.Tip="{loc:Localize HlDarkenTip}" />
                        </StackPanel>
                        <!-- ダークで読みにくい色（v1.8.2 extFS E-4） -->
                        <TextBlock Grid.Column="12" Text="⚠" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Uv_9A6B18}" IsVisible="{Binding LowContrast}"
                                   ToolTip.Tip="{loc:Localize HlLowContrastTip}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </DockPanel>
</UserControl>
