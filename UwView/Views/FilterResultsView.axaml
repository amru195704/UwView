<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:UwView.ViewModels"
             xmlns:ctrl="using:UwView.Controls"
             xmlns:loc="using:UwView.Localization"
             mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="520"
             x:Class="UwView.Views.FilterResultsView"
             x:DataType="vm:FilterResultsViewModel">

    <DockPanel LastChildFill="True">

        <!-- ツールバー: 件数 / 前後±N（Pro のみ表示）/ 保存（閉じるは右下。ポップアップの決まり） -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Uv_EEEEEE}" BorderBrush="{DynamicResource Uv_CCCCCC}"
                BorderThickness="0,0,0,1" Padding="6">
            <!-- 幅が足りないとき折り返す（WASM の小さいウィンドウで「閉じる」が切れないように） -->
            <WrapPanel x:Name="ToolbarPanel" Orientation="Horizontal" ItemSpacing="10" LineSpacing="4"
                       VerticalAlignment="Center">
                <TextBlock Text="{Binding HitInfo}" VerticalAlignment="Center" Foreground="{DynamicResource Uv_Text}" />
                <!-- 一覧に出すもの（当たり＋ブックマーク／ブックマークだけ／当たりだけ。v1.8.2 extFS E-2） -->
                <StackPanel x:Name="ListModePanel" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"
                            IsVisible="{Binding !IsResultSet}">
                    <RadioButton x:Name="ListModeBoth" GroupName="ResultListMode" ToolTip.Tip="{loc:Localize TipResultShowBoth}" Content="{loc:Localize ResultShowBoth}"
                                 Foreground="{DynamicResource Uv_Text}" IsChecked="{Binding ShowHitsAndBookmarks, Mode=TwoWay}" />
                    <RadioButton x:Name="ListModeBookmarks" GroupName="ResultListMode" ToolTip.Tip="{loc:Localize TipResultShowBookmarks}" Content="{loc:Localize ResultShowBookmarks}"
                                 Foreground="{DynamicResource Uv_Text}" IsChecked="{Binding ShowBookmarksOnly, Mode=TwoWay}" />
                    <RadioButton x:Name="ListModeHits" GroupName="ResultListMode" ToolTip.Tip="{loc:Localize TipResultShowHits}" Content="{loc:Localize ResultShowHits}"
                                 Foreground="{DynamicResource Uv_Text}" IsChecked="{Binding ShowHitsOnly, Mode=TwoWay}" />
                </StackPanel>
                <!-- 複数ファイルの結果のとき、番号と実ファイルの対応表を開く -->
                <Button x:Name="FileListButton"
                        ToolTip.Tip="{loc:Localize TipFileList}"
                        IsVisible="{Binding IsResultSet}"
                        AutomationProperties.Name="{loc:Localize FileListButton}">
                    <Image Width="22" Height="22" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{DynamicResource Icon_filelist}" />
                </Button>
                <!-- 上限で打ち切ったとき、上限を変える設定画面へ（UVP のみ） -->
                <Button x:Name="ChangeLimitButton"
                        ToolTip.Tip="{loc:Localize TipChangeSearchLimit}"
                        IsVisible="{Binding ShowChangeLimit}"
                        AutomationProperties.Name="{loc:Localize ChangeSearchLimit}">
                    <Image Width="22" Height="22" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{DynamicResource Icon_tune}" />
                </Button>
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                            IsVisible="{Binding AllowContext}">
                    <TextBlock Text="{loc:Localize ContextLabel}" VerticalAlignment="Center" Foreground="{DynamicResource Uv_Text}" />
                    <NumericUpDown x:Name="ContextBox" Value="{Binding ContextN, Mode=TwoWay}" Minimum="0" Maximum="{Binding MaxContext}"
                                   Increment="1" FormatString="0" Width="120" />
                    <TextBlock Text="{loc:Localize ContextLinesSuffix}" VerticalAlignment="Center" Foreground="{DynamicResource Uv_Text}" />
                </StackPanel>
                <Rectangle Width="1" Fill="{DynamicResource Uv_CCCCCC}" Margin="2,0" />
                <CheckBox Content="{loc:Localize IncludeLineNumbers}" Foreground="{DynamicResource Uv_Text}"
                          ToolTip.Tip="{loc:Localize TipIncludeLineNumbers}"
                          IsChecked="{Binding IncludeLineNumbersOnSave, Mode=TwoWay}" />
                <!-- 抽出保存のオプション（Pro のみ。±N と同じ AllowContext で出し分ける） -->
                <CheckBox Content="{loc:Localize IncludeHeaderOnSave}" Foreground="{DynamicResource Uv_Text}"
                          ToolTip.Tip="{loc:Localize TipIncludeHeader}"
                          IsChecked="{Binding IncludeHeaderOnSave, Mode=TwoWay}"
                          IsVisible="{Binding AllowExtractOptions}" />
                <CheckBox Content="{loc:Localize IncludeContextOnSave}" Foreground="{DynamicResource Uv_Text}"
                          ToolTip.Tip="{loc:Localize TipIncludeContext}"
                          IsChecked="{Binding IncludeContextOnSave, Mode=TwoWay}"
                          IsVisible="{Binding ContextSaveApplies}" />
                <Button x:Name="SaveButton" Content="{loc:Localize SaveEllipsis}"
                        ToolTip.Tip="{loc:Localize TipSaveFilter}" />
                <ProgressBar Width="130" Minimum="0" Maximum="1"
                             Value="{Binding SaveProgress}" IsVisible="{Binding IsSaving}" />
                <Button x:Name="CancelSaveButton" Content="{loc:Localize Cancel}"
                        ToolTip.Tip="{loc:Localize TipCancelSave}"
                        IsVisible="{Binding IsSaving}" />
            </WrapPanel>
        </Border>

        <!-- 下のバー: 閉じる（右下に固定。ポップアップの決まり）と、
             複数ファイルの結果のときは選んでいる行のファイル（番号: 実ファイル名） -->
        <Border x:Name="BottomBar" DockPanel.Dock="Bottom" Background="{DynamicResource Uv_F5F5F5}" BorderBrush="{DynamicResource Uv_CCCCCC}"
                BorderThickness="0,1,0,0" Padding="6,4">
            <DockPanel LastChildFill="True">
                <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="{loc:Localize Close}"
                        Margin="8,0,0,0" ToolTip.Tip="{loc:Localize TipCloseList}" />
                <TextBlock x:Name="CursorFileText" Text="{Binding CursorFileText}" Foreground="{DynamicResource Uv_Text}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding IsResultSet}" />
            </DockPanel>
        </Border>

        <!-- 結果リスト（自前描画。メインの TextView と同じ方式で可視行だけ描く。
             ダブルクリック/Enter でメインへジャンプ、左ドラッグで行範囲選択、右クリックで copy/save。
             ListArea は Pro の矩形選択オーバーレイ挿入先 -->
        <Grid x:Name="ListArea" ColumnDefinitions="*,Auto" RowDefinitions="*,Auto">
            <ctrl:FilterListView x:Name="RowList" Grid.Row="0" Grid.Column="0" />
            <ScrollBar x:Name="RowScroll" Grid.Row="0" Grid.Column="1" Orientation="Vertical"
                       AllowAutoHide="False" Width="14" />
            <!-- 長い行を最後まで読むための横スクロール（番号列は左固定・本文だけ動く） -->
            <ScrollBar x:Name="RowHScroll" Grid.Row="1" Grid.Column="0" Orientation="Horizontal"
                       AllowAutoHide="False" Height="14" />
        </Grid>

    </DockPanel>
</UserControl>
