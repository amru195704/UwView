<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:UwView"
             x:Class="UwView.App"
             Name="UwView"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="About UwView" Click="OnAboutClick" />
            <NativeMenuItemSeparator />
            <!-- 設定の画面（キーの割り当てなど。v1.8.2 extFS E-3） -->
            <NativeMenuItem Header="設定…" Click="OnSettingsClick" Gesture="Cmd+OemComma" />
        </NativeMenu>
    </NativeMenu.Menu>

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <!-- 画面の色（ライト／ダーク。v1.8.2 extFS E-4） -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://UwView/Themes/Palette.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <!-- 候補の一覧（検索履歴など）が開いているときの1回目のクリックを、一覧を閉じるだけで終わらせない。
             既定では透明な層がクリックを受け止めるので、隣の虫眼鏡などを押しても1回目は効かなかった
             （9.14修正）。閉じると同時に、押した場所のボタンにも届ける -->
        <Style Selector="AutoCompleteBox /template/ Popup">
            <Setter Property="OverlayDismissEventPassThrough" Value="True" />
        </Style>
    </Application.Styles>
</Application>